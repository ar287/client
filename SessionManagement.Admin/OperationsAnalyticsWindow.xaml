<Window x:Class="SessionManagement.Admin.OperationsAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operations Analytics &amp; Revenue Intelligence" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#ECF0F5">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <Button x:Name="RefreshBtn" Content="🔄 Refresh Analytics" Click="RefreshBtn_Click" DockPanel.Dock="Right" Padding="12,6" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock Text="📈 Operations &amp; Revenue Analytics" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Deterministic usage metrics, revenue ranking, and peak-hour analysis." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- KPI Metric Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Revenue" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalRevenueText" Text="$0.00" Foreground="#059669" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Total Sessions" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalSessionsText" Text="0" Foreground="#2563EB" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Occupancy Rate" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OccupancyRateText" Text="0%" Foreground="#D97706" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Peak Hour" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PeakHourText" Text="14:00 - 15:00" Foreground="#7C3AED" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Data Grids Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PC Fleet Ranking -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock Text="🏆 PC Utilization &amp; Revenue Ranking" FontSize="14" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid x:Name="PcRankingGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PC Identity" Binding="{Binding ClientId}" Width="*"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="Auto"/>
                            <DataGridTextColumn Header="Minutes" Binding="{Binding TotalMinutes}" Width="Auto"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat='${0:F2}'}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Hourly Peak Breakdown -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock Text="🕒 Hourly Usage &amp; Peak Breakdown" FontSize="14" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid x:Name="HourlyGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hour Window" Binding="{Binding HourLabel}" Width="*"/>
                            <DataGridTextColumn Header="Active Sessions" Binding="{Binding ActiveSessions}" Width="Auto"/>
                            <DataGridTextColumn Header="Total Revenue" Binding="{Binding TotalRevenue, StringFormat='${0:F2}'}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
