<Window x:Class="SessionManagement.Admin.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Management"
        Height="820" Width="1180"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B2E4B">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="👥  "
                               FontSize="22" Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Customer Management"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Create, edit and manage customer accounts"
                                   FontSize="12" Foreground="#90B4D4"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="➕  Add New Customer"
                            Height="42" Padding="20,0"
                            Margin="0,0,12,0"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="AddCustomer_Click"
                            Style="{StaticResource SuccessButtonStyle}"/>
                    <Button Content="✖  Close"
                            Height="42" Padding="20,0"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click"
                            Style="{StaticResource AdminPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ STATS ROW ══════════════ -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL CUSTOMERS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalCustomersText"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#1B2E4B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ActiveCustomersText"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#1E8449"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EAFAF1"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="INACTIVE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="InactiveCustomersText"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FDEDEC"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="❌" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3"
                    Background="White" CornerRadius="12" Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL REVENUE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalRevenueText"
                                   Text="Rs. 0" FontSize="26"
                                   FontWeight="Bold" Foreground="#D68910"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF9F0"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="💰" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ FILTER BAR ══════════════ -->
        <Border Grid.Row="2"
                Margin="22,0,22,10"
                Background="White"
                CornerRadius="12"
                Padding="22,0">
            <Border.Effect>
                <DropShadowEffect Color="#BBC8D8" BlurRadius="10"
                                  ShadowDepth="1" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                        Margin="0,14,16,14"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="42"
                                 FontSize="14"
                                 Padding="4,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="#1B2E4B"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Status Filter -->
                <Border Grid.Column="1"
                        Margin="0,14,16,14"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <ComboBox x:Name="StatusFilterBox"
                              Height="42"
                              FontSize="14"
                              Padding="14,0"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalContentAlignment="Center"
                              SelectionChanged="StatusFilter_Changed">
                        <ComboBoxItem Content="🔵  All Customers"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="✅  Active Only"/>
                        <ComboBoxItem Content="❌  Inactive Only"/>
                    </ComboBox>
                </Border>

                <!-- Search Button -->
                <Button Grid.Column="2"
                        Content="🔍  Search"
                        Margin="0,14,10,14"
                        Height="42"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="SearchButton_Click"
                        Style="{StaticResource AdminPrimaryButtonStyle}"/>

                <!-- Reset Button -->
                <Button Grid.Column="3"
                        Content="🔄  Reset"
                        Margin="0,14,0,14"
                        Height="42"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="ResetFilter_Click"
                        Style="{StaticResource WarningButtonStyle}"/>
            </Grid>
        </Border>

        <!-- ══════════════ TABLE ══════════════ -->
        <Border Grid.Row="3"
                Margin="22,0,22,0"
                Background="White"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                  ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0"
                        Background="#F7FAFC"
                        CornerRadius="12,12,0,0"
                        Padding="22,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📋  "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Customer List"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#1B2E4B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TableSubtitleText"
                                   Text="0 records"
                                   FontSize="13"
                                   Foreground="#9BABBE"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Loading / Empty State -->
                <Border x:Name="LoadingBorder"
                        Grid.Row="1"
                        Padding="40"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="👥"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock x:Name="LoadingText"
                                   Text="Loading customers..."
                                   FontSize="16"
                                   Foreground="#7A8CA0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Customer ListView -->
                <ListView x:Name="CustomersListView"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          FontSize="14"
                          Visibility="Collapsed"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged=
                          "CustomersListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="👤  Full Name"
                                            Width="160"
                                DisplayMemberBinding="{Binding FullName}"/>
                            <GridViewColumn Header="🔖  Username"
                                            Width="130"
                                DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="📌  Status"
                                            Width="120"
                                DisplayMemberBinding=
                                "{Binding StatusDisplay}"/>
                            <GridViewColumn Header="📅  Joined"
                                            Width="120"
                                DisplayMemberBinding="{Binding CreatedAt}"/>
                            <GridViewColumn Header="🕐  Last Seen"
                                            Width="160"
                                DisplayMemberBinding="{Binding LastSeen}"/>
                            <GridViewColumn Header="📊  Sessions"
                                            Width="100"
                                DisplayMemberBinding=
                                "{Binding SessionsDisplay}"/>
                            <GridViewColumn Header="💵  Spent"
                                            Width="120"
                                DisplayMemberBinding=
                                "{Binding SpentDisplay}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- ══════════════ ACTION BAR ══════════════ -->
        <Border Grid.Row="4" Background="#1B2E4B" Padding="22,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="💡  "
                               FontSize="12" Foreground="#90B4D4"/>
                    <TextBlock x:Name="StatusText"
                               Text="Select a customer to perform actions"
                               FontSize="12" Foreground="#90B4D4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="EditButton"
                            Content="✏️  Edit"
                            Height="34" Padding="16,0"
                            Margin="0,0,8,0"
                            FontSize="12" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="EditCustomer_Click"
                            Style="{StaticResource AdminPrimaryButtonStyle}"/>
                    <Button x:Name="ToggleStatusButton"
                            Content="🔄  Toggle Status"
                            Height="34" Padding="16,0"
                            Margin="0,0,8,0"
                            FontSize="12" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="ToggleStatus_Click"
                            Style="{StaticResource WarningButtonStyle}"/>
                    <Button x:Name="DeleteButton"
                            Content="🗑️  Delete"
                            Height="34" Padding="16,0"
                            FontSize="12" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="DeleteCustomer_Click"
                            Style="{StaticResource AdminDangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
