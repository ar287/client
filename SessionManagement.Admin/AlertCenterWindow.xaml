<Window x:Class="SessionManagement.Admin.AlertCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Center — Real-Time Monitoring"
        Height="860" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B2E4B">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🔔  "
                               FontSize="22" Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Alert Center"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Real-time security and activity monitoring"
                                   FontSize="12" Foreground="#90B4D4"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live indicator -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot"
                             Width="10" Height="10"
                             Fill="#2ECC71"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="LIVE"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#2ECC71"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✖  Close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="42" Padding="20,0"
                        FontSize="14" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_Click"
                        Style="{StaticResource AdminPrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <!-- ══════════════ STAT CARDS ══════════════ -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalCount"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#1B2E4B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- High -->
            <Border Grid.Column="1" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="HIGH"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="HighCount"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#C0392B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FDEDEC"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🔴" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Medium -->
            <Border Grid.Column="2" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MEDIUM"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="MediumCount"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#D68910"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF9F0"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🟡" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Low -->
            <Border Grid.Column="3" Margin="0,0,12,0"
                    Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="LOW"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LowCount"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#1E8449"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EAFAF1"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🟢" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Unread -->
            <Border Grid.Column="4"
                    Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="UNREAD"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UnreadCount"
                                   Text="0" FontSize="34"
                                   FontWeight="Bold" Foreground="#2471A3"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🔵" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ FILTER BAR ══════════════ -->
        <Border Grid.Row="2"
                Margin="22,0,22,10"
                Background="White"
                CornerRadius="12"
                Padding="22,0">
            <Border.Effect>
                <DropShadowEffect Color="#BBC8D8" BlurRadius="10"
                                  ShadowDepth="1" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="44"
                                 FontSize="13"
                                 Padding="4,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="#1B2E4B"
                                 TextChanged="Filter_Changed"/>
                    </Grid>
                </Border>

                <!-- Severity Filter -->
                <Border Grid.Column="1"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <ComboBox x:Name="SeverityFilter"
                               Height="44"
                               FontSize="13"
                               Padding="12,0"
                               BorderThickness="0"
                               Background="Transparent"
                               VerticalContentAlignment="Center"
                               SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Severities"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="🔴  High"/>
                        <ComboBoxItem Content="🟡  Medium"/>
                        <ComboBoxItem Content="🟢  Low"/>
                    </ComboBox>
                </Border>

                <!-- Start Date -->
                <Border Grid.Column="2"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <DatePicker x:Name="StartDatePicker"
                                Height="44"
                                FontSize="11"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="Filter_Changed"/>
                </Border>

                <!-- End Date -->
                <Border Grid.Column="3"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <DatePicker x:Name="EndDatePicker"
                                Height="44"
                                FontSize="11"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="Filter_Changed"/>
                </Border>

                <!-- Type Filter -->
                <Border Grid.Column="4"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <ComboBox x:Name="TypeFilter"
                               Height="44"
                               FontSize="13"
                               Padding="12,0"
                               BorderThickness="0"
                               Background="Transparent"
                               VerticalContentAlignment="Center"
                               SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Types"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="🔐  FailedLogin"/>
                        <ComboBoxItem Content="🔄  DuplicateSession"/>
                        <ComboBoxItem Content="⚡  RateLimit"/>
                        <ComboBoxItem Content="🛑  SessionTerminated"/>
                    </ComboBox>
                </Border>

                <!-- Unread Toggle -->
                <Border Grid.Column="5"
                        Margin="0,12,8,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <ComboBox x:Name="ReadFilter"
                               Height="44"
                               FontSize="12"
                               Padding="8,0"
                               BorderThickness="0"
                               Background="Transparent"
                               VerticalContentAlignment="Center"
                               SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Alerts"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="🔵  Unread"/>
                    </ComboBox>
                </Border>

                <!-- Refresh -->
                <Border Grid.Column="6"
                        Margin="0,12,8,12">
                   <Button Content="🔄"
                           Height="44"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White" BorderThickness="0"
                           Cursor="Hand"
                           Click="Refresh_Click"
                           Style="{StaticResource AdminPrimaryButtonStyle}"/>
                </Border>

                <!-- Mark All Read -->
                <Button Grid.Column="7"
                        Content="✅  All Read"
                        Margin="0,12,0,12"
                        Height="44"
                        FontSize="12" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="MarkAllRead_Click"
                        Style="{StaticResource SuccessButtonStyle}"/>
            </Grid>
        </Border>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <Grid Grid.Row="3" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Alert List -->
            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Background="White"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F7FAFC"
                            CornerRadius="12,12,0,0"
                            Padding="22,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="📋  "
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Alert Log"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1B2E4B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="AlertCountText"
                                       Text="0 alerts"
                                       FontSize="13"
                                       Foreground="#9BABBE"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="EmptyBorder"
                            Grid.Row="1"
                            Padding="40"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🔔"
                                       FontSize="52"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock x:Name="EmptyText"
                                       Text="Loading alerts..."
                                       FontSize="16"
                                       Foreground="#7A8CA0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Alert ListView -->
                    <ListView x:Name="AlertsListView"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="13"
                              Visibility="Collapsed"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="AlertsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header=""
                                                Width="34"
                                    DisplayMemberBinding=
                                    "{Binding ReadIcon}"/>
                                <GridViewColumn Header="⏰  Time"
                                                Width="150"
                                    DisplayMemberBinding=
                                    "{Binding CreatedAt}"/>
                                <GridViewColumn Header="📌  Severity"
                                                Width="110"
                                    DisplayMemberBinding=
                                    "{Binding DisplayTitle}"/>
                                <GridViewColumn Header="🔖  Type"
                                                Width="160"
                                    DisplayMemberBinding=
                                    "{Binding AlertType}"/>
                                <GridViewColumn Header="👤  User"
                                                Width="110"
                                    DisplayMemberBinding=
                                    "{Binding Username}"/>
                                <GridViewColumn Header="📝  Description"
                                                Width="300"
                                    DisplayMemberBinding=
                                    "{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0"
                            Background="#F7FAFC"
                            CornerRadius="12,12,0,0"
                            Padding="22,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🔍  "
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Alert Details"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1B2E4B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,20">

                            <!-- No selection state -->
                            <StackPanel x:Name="NoSelectionPanel"
                                        HorizontalAlignment="Center"
                                        Margin="0,60,0,0">
                                <TextBlock Text="👆"
                                           FontSize="44"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,14"/>
                                <TextBlock Text="Select an alert to view details"
                                           FontSize="14"
                                           Foreground="#9BABBE"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Detail cards -->
                            <StackPanel x:Name="DetailPanel"
                                        Visibility="Collapsed">

                                <!-- Severity Badge -->
                                <Border x:Name="SeverityBadge"
                                        CornerRadius="10"
                                        Padding="18,14"
                                        Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DetailSeverityIcon"
                                                   FontSize="28"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailSeverityText"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DetailTypeText"
                                                       FontSize="13"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Info Cards -->
                                <Border Background="#F7FAFC"
                                        BorderBrush="#C8D6E5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="⏰  TIME"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DetailTimeText"
                                                   FontSize="14"
                                                   Foreground="#1B2E4B"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F7FAFC"
                                        BorderBrush="#C8D6E5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="👤  USER"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DetailUserText"
                                                   FontSize="14"
                                                   Foreground="#1B2E4B"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F7FAFC"
                                        BorderBrush="#C8D6E5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📝  DESCRIPTION"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DetailDescText"
                                                   FontSize="13"
                                                   Foreground="#1B2E4B"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══════════════ AI THREAT TRIAGE CARD ══════════════ -->
                                <Border Background="#F4F6F9"
                                        BorderBrush="#2980B9"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🤖  AI THREAT TRIAGE (OLLAMA)"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2980B9"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="AIAnalyzeButton"
                                                    Content="⚡ Run AI Triage"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Background="#2980B9"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="AIAnalyze_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="AIThreatBadgeText"
                                                   Text="⚪ Click 'Run AI Triage' for local AI analysis"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#1B2E4B"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AIExplanationText"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="#34495E"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AIActionText"
                                                   Text=""
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#27AE60"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mark Read Button -->
                                <Button x:Name="MarkReadButton"
                                        Content="✅  Mark as Read"
                                        Height="46"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="MarkSingleRead_Click"
                                        Style=
                                        "{StaticResource SuccessButtonStyle}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ STATUS BAR ══════════════ -->
        <Border Grid.Row="4" Background="#1B2E4B" Padding="22,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📡  "
                               FontSize="12" Foreground="#90B4D4"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="12" Foreground="#90B4D4"/>
                </StackPanel>
                <TextBlock x:Name="ClockText"
                           FontSize="12" Foreground="#90B4D4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
