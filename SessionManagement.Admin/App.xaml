                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#B0BFCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
