<Window x:Class="SessionManagement.Admin.CustomerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="620" Width="520"
        MinHeight="580" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="580">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1B2E4B">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30">
                    <TextBlock x:Name="FormTitleIcon"
                               Text="➕"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="FormTitle"
                               Text="Add New Customer"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <Border Grid.Row="1"
                    Margin="32,24,32,32"
                    Background="White"
                    CornerRadius="14"
                    Padding="36,32">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8"
                                      BlurRadius="20"
                                      ShadowDepth="3"
                                      Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Full Name -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="👤  "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="FULL NAME"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>
                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC">
                            <TextBox x:Name="FullNameBox"
                                     Height="50"
                                     FontSize="15"
                                     Padding="16,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="#1B2E4B"/>
                        </Border>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="🔖  "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="USERNAME"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>
                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC">
                            <TextBox x:Name="UsernameBox"
                                     Height="50"
                                     FontSize="15"
                                     Padding="16,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="#1B2E4B"/>
                        </Border>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="🔑  "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PasswordLabel"
                                       Text="PASSWORD"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>
                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC">
                            <PasswordBox x:Name="PasswordBox"
                                         Height="50"
                                         FontSize="15"
                                         Padding="16,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Foreground="#1B2E4B"/>
                        </Border>
                        <TextBlock x:Name="PasswordHint"
                                   Text="Minimum 6 characters required."
                                   FontSize="12"
                                   Foreground="#9BABBE"
                                   Margin="4,6,0,0"/>
                    </StackPanel>

                    <!-- Error Box -->
                    <Border x:Name="ErrorBorder"
                            Background="#FEF0EF"
                            BorderBrush="#F5B7B1"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  "
                                       FontSize="16"
                                       Foreground="#C0392B"/>
                            <TextBlock x:Name="ErrorMessage"
                                       FontSize="13"
                                       Foreground="#C0392B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Success Box -->
                    <Border x:Name="SuccessBorder"
                            Background="#EAFAF1"
                            BorderBrush="#A9DFBF"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅  "
                                       FontSize="16"
                                       Foreground="#1E8449"/>
                            <TextBlock x:Name="SuccessMessage"
                                       FontSize="13"
                                       Foreground="#1E8449"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="✖  Cancel"
                                Height="50"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#1B2E4B"
                                BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                Cursor="Hand"
                                Click="Cancel_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate
                                                TargetType="Button">
                                                <Border
                                                    x:Name="Bd"
                                                    Background=
                                                    "{TemplateBinding Background}"
                                                    BorderBrush=
                                                    "{TemplateBinding BorderBrush}"
                                                    BorderThickness=
                                                    "{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                    <ContentPresenter
                                                        HorizontalAlignment
                                                        ="Center"
                                                        VerticalAlignment
                                                        ="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property=
                                                        "IsMouseOver"
                                                        Value="True">
                                                        <Setter
                                                            TargetName="Bd"
                                                            Property=
                                                            "Background"
                                                            Value="#F0F4F8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="SaveButton"
                                Grid.Column="2"
                                Height="50"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Save_Click"
                                Style="{StaticResource SuccessButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SaveButtonIcon"
                                           Text="✅  "
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="SaveButtonText"
                                           Text="Save Customer"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
