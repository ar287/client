<Window x:Class="SessionManagement.Admin.ApprovalQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Authorization Queue &amp; Action Approval"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F5">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stat Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ 1. HEADER ══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#3B82F6" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Security Action Authorization Queue"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Review, authorize, or reject automated high-risk policy actions requiring administrator consent"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Content="🔄 Refresh Queue"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="38" Padding="16,0"
                    FontSize="12" FontWeight="Bold"
                    Foreground="White" Background="#334155"
                    BorderThickness="0" Cursor="Hand"
                    Click="Refresh_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ══════════════ 2. STAT BAR ══════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Queue -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL REQUESTS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TotalRequestsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Pending -->
            <Border Grid.Column="1" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="PENDING AUTHORIZATION" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock x:Name="PendingCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Approved -->
            <Border Grid.Column="2" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="APPROVED ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                    <TextBlock x:Name="ApprovedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Rejected -->
            <Border Grid.Column="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="REJECTED ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock x:Name="RejectedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════ 3. MAIN CONTENT ══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Items Grid -->
            <Border Grid.Column="0" Margin="0,0,12,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 Authorization Requests" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <DataGrid x:Name="ApprovalsDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="ApprovalsDataGrid_SelectionChanged"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              Foreground="#0F172A"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Client PC" Binding="{Binding ClientId}" Width="100"/>
                            <DataGridTextColumn Header="Rule Triggered" Binding="{Binding RuleName}" Width="140"/>
                            <DataGridTextColumn Header="Requested Action" Binding="{Binding ActionType}" Width="120"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore}" Width="50"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Requested At" Binding="{Binding RequestedAtUtc, StringFormat={}{0:HH:mm:ss dd/MM}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Decision & Details Panel -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="🔍 Selected Request Details" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel x:Name="DetailsPanel">
                            <TextBlock x:Name="DetailTitleText" Text="Select a request from the table" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="DetailClientText" Text="Client: -" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DetailActionText" Text="Action: -" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            <TextBlock x:Name="DetailReasonText" Text="Reason: -" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailStatusText" Text="Status: -" FontSize="12" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="👤 Administrator Name" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReviewerNameBox" Text="Admin" Height="34" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="📝 Audit Review Notes" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReviewNotesBox" Text="Authorized per lab security compliance policy." Height="60" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,6" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Action Buttons -->
                    <Button x:Name="ApproveButton" Content="✅ AUTHORIZE ACTION"
                            Height="42" FontSize="13" FontWeight="Bold"
                            Foreground="White" Background="#10B981"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                            IsEnabled="False" Click="Approve_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="RejectButton" Content="❌ REJECT ACTION"
                            Height="42" FontSize="13" FontWeight="Bold"
                            Foreground="White" Background="#EF4444"
                            BorderThickness="0" Cursor="Hand"
                            IsEnabled="False" Click="Reject_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════ 4. FOOTER ══════════════ -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready." FontSize="12" Foreground="#64748B" Margin="0,12,0,0"/>
    </Grid>
</Window>
