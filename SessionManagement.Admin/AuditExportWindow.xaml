<Window x:Class="SessionManagement.Admin.AuditExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forensic Audit Trail &amp; Compliance Log Export Engine"
        Height="740" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F5">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Controls / Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid Main -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ 1. HEADER ══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#6366F1" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Forensic Audit Trail &amp; Forensic Log Exporter"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Compile and export structured compliance audit reports in CSV and JSON formats for cybersecurity inspection"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ══════════════ 2. CONTROLS BAR ══════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Source Category -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="🔍 Category Filter" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryCombo" Height="36" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,6" SelectedIndex="0">
                        <ComboBoxItem Content="All Categories" Tag="All"/>
                        <ComboBoxItem Content="Activity Events" Tag="ActivityEvent"/>
                        <ComboBoxItem Content="Remediation Actions" Tag="RemediationLog"/>
                        <ComboBoxItem Content="Approval Actions" Tag="PendingApproval"/>
                    </ComboBox>
                </StackPanel>

                <!-- Client PC -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="🖥️ Target Client PC (Optional)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox x:Name="ClientIdBox" Height="36" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,6"/>
                </StackPanel>

                <!-- Export Format -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="📄 Export Format" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FormatCombo" Height="36" FontSize="12" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,6" SelectedIndex="0">
                        <ComboBoxItem Content="CSV Format (.csv)" Tag="CSV"/>
                        <ComboBoxItem Content="JSON Format (.json)" Tag="JSON"/>
                    </ComboBox>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔍 Preview Timeline"
                            Height="36" Padding="14,0" Margin="0,0,8,0"
                            FontSize="12" FontWeight="Bold"
                            Foreground="White" Background="#3B82F6"
                            BorderThickness="0" Cursor="Hand"
                            Click="PreviewTimeline_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="💾 Export Forensic File"
                            Height="36" Padding="14,0"
                            FontSize="12" FontWeight="Bold"
                            Foreground="White" Background="#10B981"
                            BorderThickness="0" Cursor="Hand"
                            Click="ExportFile_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ 3. MAIN DATAGRID ══════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📊 Forensic Timeline Preview" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <DataGrid x:Name="TimelineDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          Foreground="#0F172A"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding SourceCategory}" Width="120"/>
                        <DataGridTextColumn Header="Client PC" Binding="{Binding ClientId}" Width="100"/>
                        <DataGridTextColumn Header="Event / Rule" Binding="{Binding EventTypeOrRule}" Width="150"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══════════════ 4. FOOTER ══════════════ -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready to compile audit trail." FontSize="12" Foreground="#64748B" Margin="0,12,0,0"/>
    </Grid>
</Window>
