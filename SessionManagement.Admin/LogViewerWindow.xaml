<Window x:Class="SessionManagement.Admin.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Log Viewer"
        Height="860" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B2E4B">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📝  "
                               FontSize="22" Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="System Log Viewer"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Complete audit trail of all system events"
                                   FontSize="12" Foreground="#90B4D4"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Content="✨  AI Executive Brief"
                            Height="42" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" Background="#2980B9" BorderThickness="0"
                            Cursor="Hand"
                            Click="AISummary_Click"/>
                    <Button Content="🗑️  Clear Old Logs"
                            Height="42" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="ClearLogs_Click"
                            Style="{StaticResource AdminDangerButtonStyle}"/>
                    <Button Content="✖  Close"
                            Height="42" Padding="20,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click"
                            Style="{StaticResource AdminPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ STAT CARDS ══════════════ -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="TOTAL LOGS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalLogsText"
                                   Text="0" FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1B2E4B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="LOGINS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="LoginLogsText"
                                   Text="0" FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1E8449"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EAFAF1"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🔓" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="SESSIONS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="SessionLogsText"
                                   Text="0" FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#2471A3"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="FAILED LOGINS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="FailedLogsText"
                                   Text="0" FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#C0392B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FDEDEC"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="⛔" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="White" CornerRadius="12"
                    Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="TERMINATIONS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TermLogsText"
                                   Text="0" FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#D68910"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF9F0"
                            CornerRadius="10" Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🛑" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ FILTER BAR ══════════════ -->
        <Border Grid.Row="2"
                Margin="22,0,22,10"
                Background="White"
                CornerRadius="12"
                Padding="22,0">
            <Border.Effect>
                <DropShadowEffect Color="#BBC8D8" BlurRadius="10"
                                  ShadowDepth="1" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Margin="0,12,12,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="44"
                                 FontSize="13"
                                 Padding="4,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="#1B2E4B"/>
                    </Grid>
                </Border>

                <!-- Event Type -->
                <Border Grid.Column="1"
                        Margin="0,12,12,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <ComboBox x:Name="EventTypeFilter"
                              Height="44"
                              FontSize="13"
                              Padding="12,0"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="All Events"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="🔓  Login"/>
                        <ComboBoxItem Content="🔒  Logout"/>
                        <ComboBoxItem Content="⛔  LoginFailed"/>
                        <ComboBoxItem Content="▶️  SessionStart"/>
                        <ComboBoxItem Content="⏹️  SessionEnd"/>
                        <ComboBoxItem Content="🛑  SessionTerminated"/>
                        <ComboBoxItem Content="💰  BillingGenerated"/>
                    </ComboBox>
                </Border>

                <!-- Date From -->
                <Border Grid.Column="2"
                        Margin="0,12,12,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <DatePicker x:Name="DateFromPicker"
                                Height="44"
                                FontSize="13"
                                Padding="8,0"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"/>
                </Border>

                <!-- Date To -->
                <Border Grid.Column="3"
                        Margin="0,12,12,12"
                        BorderBrush="#C8D6E5"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#F7FAFC">
                    <DatePicker x:Name="DateToPicker"
                                Height="44"
                                FontSize="13"
                                Padding="8,0"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"/>
                </Border>

                <!-- Search Button -->
                <Button Grid.Column="4"
                        Content="🔍  Search"
                        Margin="0,12,10,12"
                        Height="44"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="SearchButton_Click"
                        Style=
                        "{StaticResource AdminPrimaryButtonStyle}"/>

                <!-- Reset Button -->
                <Button Grid.Column="5"
                        Content="🔄  Reset"
                        Margin="0,12,0,12"
                        Height="44"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Click="ResetButton_Click"
                        Style="{StaticResource WarningButtonStyle}"/>
            </Grid>
        </Border>

        <!-- ══════════════ TABLE ══════════════ -->
        <Border Grid.Row="3"
                Margin="22,0,22,0"
                Background="White"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                  ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Title -->
                <Border Grid.Row="0"
                        Background="#F7FAFC"
                        CornerRadius="12,12,0,0"
                        Padding="22,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📋  "
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Event Log"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1B2E4B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="RecordCountText"
                                   Text="0 records"
                                   FontSize="13"
                                   Foreground="#9BABBE"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ══════════════ AI EXECUTIVE BRIEF BANNER ══════════════ -->
                <Border x:Name="AISummaryBorder"
                        Grid.Row="0"
                        Background="#EBF5FB"
                        BorderBrush="#2980B9"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Margin="22,50,22,-120"
                        Padding="16,12"
                        Panel.ZIndex="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="✨  AI EXECUTIVE SHIFT BRIEF (OLLAMA)"
                                       FontSize="12" FontWeight="Bold" Foreground="#1B2E4B"/>
                            <TextBlock x:Name="AIRiskBadge"
                                       Text=" [Risk: Low]"
                                       FontSize="12" FontWeight="Bold" Foreground="#27AE60" Margin="10,0,0,0"/>
                            <Button Content="✖" HorizontalAlignment="Right"
                                    Foreground="#7F8C8D" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Margin="20,0,0,0" Click="CloseAISummary_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AISummaryText"
                                   Grid.Row="1"
                                   Text="Summary text goes here..."
                                   FontSize="12" Foreground="#2C3E50" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Empty State -->
                <Border x:Name="EmptyBorder"
                        Grid.Row="1"
                        Padding="40"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="📝"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock x:Name="EmptyText"
                                   Text="Loading logs..."
                                   FontSize="16"
                                   Foreground="#7A8CA0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Log ListView -->
                <ListView x:Name="LogsListView"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          FontSize="13"
                          Visibility="Collapsed"
                          ScrollViewer.VerticalScrollBarVisibility
                          ="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#"
                                            Width="60"
                                DisplayMemberBinding=
                                "{Binding LogId}"/>
                            <GridViewColumn Header="⏰  Time"
                                            Width="160"
                                DisplayMemberBinding=
                                "{Binding CreatedAt}"/>
                            <GridViewColumn Header="📌  Event"
                                            Width="160"
                                DisplayMemberBinding=
                                "{Binding DisplayEvent}"/>
                            <GridViewColumn Header="👤  User"
                                            Width="120"
                                DisplayMemberBinding=
                                "{Binding FullName}"/>
                            <GridViewColumn Header="🔖  Username"
                                            Width="110"
                                DisplayMemberBinding=
                                "{Binding Username}"/>
                            <GridViewColumn Header="#️⃣  Session"
                                            Width="90"
                                DisplayMemberBinding=
                                "{Binding SessionId}"/>
                            <GridViewColumn Header="📝  Description"
                                            Width="380"
                                DisplayMemberBinding=
                                "{Binding Description}"/>
                            <GridViewColumn Header="🌐  IP"
                                            Width="120"
                                DisplayMemberBinding=
                                "{Binding IPAddress}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- ══════════════ STATUS BAR ══════════════ -->
        <Border Grid.Row="4" Background="#1B2E4B" Padding="22,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📡  " FontSize="12"
                               Foreground="#90B4D4"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="12"
                               Foreground="#90B4D4"/>
                </StackPanel>
                <TextBlock x:Name="ClockText"
                           FontSize="12" Foreground="#90B4D4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
