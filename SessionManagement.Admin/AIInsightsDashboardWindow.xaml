<Window x:Class="SessionManagement.Admin.AIInsightsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Intelligence &amp; Ollama Insights Dashboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#ECF0F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <Button x:Name="GenerateSummaryBtn" Content="🤖 Generate Shift Executive Brief" Click="GenerateSummaryBtn_Click" DockPanel.Dock="Right" Padding="12,6" Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock Text="🧠 AI Security &amp; Operational Intelligence" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Ollama AI local LLM shift summaries, hybrid risk scoring, and evidence explanations." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Executive Shift Summary Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📄 AI Shift Executive Brief" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <TextBlock Text="Operational Summary:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Text="Click 'Generate Shift Executive Brief' to produce LLM summary." Foreground="#1E293B" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,15"/>

                        <TextBlock Text="Operational Risk Level:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OperationalRiskText" Text="Low" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,15"/>

                        <TextBlock Text="Key Event Highlights:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListBox x:Name="KeyEventsList" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Height="250"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- AI Hybrid Risk Evaluation -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="⚡ AI Hybrid PC Risk Analysis" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="AiTargetPcInput" Text="LAB-PC-01" Width="140" Padding="6" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="RunAiAnalysisBtn" Content="Analyze with AI" Click="RunAiAnalysisBtn_Click" Padding="10,6" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="AI Hybrid Risk Score:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AiScoreText" Text="N/A" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,15"/>

                        <TextBlock Text="AI Provider &amp; Model:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AiModelText" Text="OllamaAI (llama3.2:3b)" Foreground="#334155" FontSize="12" Margin="0,5,0,15"/>

                        <TextBlock Text="Confidence Score:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AiConfidenceText" Text="0.95" Foreground="#059669" FontSize="14" FontWeight="Bold" Margin="0,5,0,15"/>

                        <TextBlock Text="AI Recommended Action:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AiRecommendedActionText" Text="Select a PC to evaluate." Foreground="#0284C7" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,15"/>

                        <TextBlock Text="AI Contextual Explanations:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListBox x:Name="AiExplanationsList" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Height="180"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
