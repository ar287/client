<Window x:Class="SessionManagement.Admin.LiveAlertFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔴 Live Security Alert Feed" Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F5"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="AlertHubDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0"/>
                    <TextBlock x:Name="AlertHubStatus" Text="Connecting..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="ClearAllBtn" Content="🗑 Clear All" Click="ClearAll_Click"
                            Padding="12,6" Background="#334155" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🔴 Live Security Alert Feed" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Real-time rule-fired alerts pushed from the server Rule Engine via SignalR." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Summary Stats Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL RECEIVED" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CRITICAL" FontSize="10" Foreground="#DC2626" FontWeight="Bold"/>
                    <TextBlock x:Name="CriticalCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="HIGH" FontSize="10" Foreground="#EA580C" FontWeight="Bold"/>
                    <TextBlock x:Name="HighCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EA580C"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="MEDIUM / LOW" FontSize="10" Foreground="#D97706" FontWeight="Bold"/>
                    <TextBlock x:Name="MedLowCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D97706"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alert Feed List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="0">
            <ScrollViewer x:Name="AlertScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AlertFeed" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="AlertCard" Margin="0,0,0,10" CornerRadius="8" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Background="{Binding CardBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Indicator -->
                                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,14,0"
                                            Background="{Binding SeverityColor}"/>

                                    <!-- Alert Content -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SeverityIcon}" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{Binding SeverityColor}"/>
                                            <TextBlock Text=" · " Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding AlertType}" Foreground="#475569" FontSize="12"/>
                                            <TextBlock Text=" · " Foreground="#94A3B8" FontSize="13"/>
                                            <TextBlock Text="{Binding RuleName}" Foreground="#2563EB" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ClientId}" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#0F172A" FontSize="13"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔧 Action: " Foreground="#64748B" FontSize="11"/>
                                            <TextBlock Text="{Binding ActionTaken}" Foreground="#334155" FontSize="11"/>
                                            <TextBlock Text="  |  Risk Score: " Foreground="#64748B" FontSize="11"/>
                                            <TextBlock Text="{Binding RiskScore}" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                               Foreground="#64748B" FontSize="11"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="LastAlertText" Text="Waiting for alerts..." Foreground="#64748B" FontSize="11"/>
                <TextBlock x:Name="SessionHubStatus" Text="SessionHub: —" Foreground="#64748B" FontSize="11"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
