<Window x:Class="SessionManagement.Admin.SecurityDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Intelligence &amp; Rule Engine Dashboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#ECF0F5">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBox x:Name="TargetPcInput" Text="LAB-PC-01" Width="120" Padding="6" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="EvaluateRiskBtn" Content="⚡ Evaluate PC Risk" Click="EvaluateRiskBtn_Click" Padding="12,6" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="🛡️ Security Intelligence &amp; Rule Engine" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Monitor active security detection rules and evaluate PC risk scores." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Security Rules List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock Text="📋 Active Security Rules &amp; Policies" FontSize="14" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Foreground="#0F172A" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding RuleName}" Width="*"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto"/>
                            <DataGridTextColumn Header="Cooldown" Binding="{Binding CooldownMinutes, StringFormat='{}{0}m'}" Width="Auto"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Risk Evaluation Result Panel -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🎯 Risk Assessment Summary" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <TextBlock Text="Target PC:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RiskTargetText" Text="N/A" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <TextBlock Text="Risk Score &amp; Level:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RiskScoreText" Text="0 / 100" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,0,10,0"/>
                            <Border x:Name="RiskBadge" Background="#10B981" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="RiskLevelText" Text="LOW" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Evaluated By:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EvaluatedByText" Text="RuleEngine" Foreground="#334155" FontSize="12" Margin="0,0,0,10"/>

                        <TextBlock Text="Recommended Action:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RecommendedActionText" Text="Select a PC and click Evaluate PC Risk." Foreground="#0284C7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="Triggered Reasons &amp; Evidence:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListBox x:Name="ReasonsListBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Height="200"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
