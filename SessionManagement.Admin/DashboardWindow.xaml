<Window x:Class="SessionManagement.Admin.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard — Session Management System"
        Height="820" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B2E4B">
            <Grid Margin="28,0">

                <!-- Left: Title -->
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="📊  "
                               FontSize="22"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Admin Dashboard"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="AdminNameText"
                                   FontSize="12"
                                   Foreground="#90B4D4"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Action Buttons -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                    <Button Content="👥  Customers"
                            Height="40" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="ViewCustomers_Click"
                            Style="{StaticResource AdminPrimaryButtonStyle}"/>
                            
                    <Button Content="💰  Billing"
                            Height="40" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="ViewBilling_Click"
                            Style="{StaticResource SuccessButtonStyle}"/>

                    <Button Content="🔔  Alerts"
                            Height="40" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="ViewSecurityAlerts_Click"
                            Style="{StaticResource AdminDangerButtonStyle}"/>

                    <Button Content="📝  Logs"
                            Height="40" Padding="18,0"
                            Margin="0,0,10,0"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"
                            Click="ViewLogs_Click"
                            Style="{StaticResource AdminPrimaryButtonStyle}"/>
                </StackPanel>

                <!-- Right: Connection Status -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#2E4D7B"
                        CornerRadius="22"
                        Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot"
                                 Width="12" Height="12"
                                 Fill="#E74C3C"
                                 Margin="0,0,10,0"/>
                        <TextBlock x:Name="ConnectionStatus"
                                   Text="Disconnected"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════ STATS ROW ══════════════ -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1 — Active Sessions -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE SESSIONS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ActiveSessionsCount"
                                   Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#1B2E4B"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#EBF5FB"
                            CornerRadius="10"
                            Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🖥️"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2 — Total Revenue -->
            <Border Grid.Column="1" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL REVENUE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalRevenueText"
                                   Text="Rs. 0.00" FontSize="28"
                                   FontWeight="Bold" Foreground="#1E8449"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#EAFAF1"
                            CornerRadius="10"
                            Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="💰"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3 — Total Alerts -->
            <Border Grid.Column="2" Margin="0,0,12,0"
                    Background="White" CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL ALERTS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TotalAlertsCount"
                                   Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#FDEDEC"
                            CornerRadius="10"
                            Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="🚨"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4 — Sessions Today -->
            <Border Grid.Column="3"
                    Background="White" CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SESSIONS TODAY"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#5A6A7E" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SessionsTodayCount"
                                   Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#2471A3"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#EBF5FB"
                            CornerRadius="10"
                            Width="46" Height="46"
                            VerticalAlignment="Center">
                        <TextBlock Text="📅"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <Grid Grid.Row="2" Margin="22,0,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: Sessions Table ══ -->
            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Background="White"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8" BlurRadius="14"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F7FAFC"
                            CornerRadius="12,12,0,0" Padding="22,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="🟢  " FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Active Sessions"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#1B2E4B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="🔄  "
                                           FontSize="13"
                                           Foreground="#9BABBE"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastRefreshText"
                                           Text="Auto-refreshes every 30s"
                                           FontSize="12"
                                           Foreground="#9BABBE"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView x:Name="SessionsListView"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="14"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged=
                              "SessionsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="👤  User"
                                                Width="150"
                                    DisplayMemberBinding=
                                    "{Binding FullName}"/>
                                <GridViewColumn Header="#  Session"
                                                Width="90"
                                    DisplayMemberBinding=
                                    "{Binding SessionId}"/>
                                <GridViewColumn Header="⏱  Time Left"
                                                Width="110"
                                    DisplayMemberBinding=
                                    "{Binding RemainingTime}"/>
                                <GridViewColumn Header="💵  Cost"
                                                Width="110"
                                    DisplayMemberBinding=
                                    "{Binding CostDisplay}"/>
                                <GridViewColumn Header="🖥️  Machine"
                                                Width="130"
                                    DisplayMemberBinding=
                                    "{Binding MachineDisplay}"/>
                                <GridViewColumn Header="🕐  Started"
                                                Width="100"
                                    DisplayMemberBinding=
                                    "{Binding StartedAt}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- ══ RIGHT: Session Detail + Actions ══ -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── Session Detail Card ── -->
                    <Border Background="White"
                            CornerRadius="12"
                            Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect Color="#BBC8D8"
                                              BlurRadius="14"
                                              ShadowDepth="2"
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>

                            <!-- Card Header -->
                            <Border Background="#F7FAFC"
                                    CornerRadius="12,12,0,0"
                                    Padding="22,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍  "
                                               FontSize="15"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Session Details"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1B2E4B"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- No selection state -->
                            <StackPanel x:Name="NoSelectionPanel"
                                        Margin="22,30"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="👆"
                                           FontSize="40"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="Select a session row"
                                           FontSize="14"
                                           Foreground="#9BABBE"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="to view full details"
                                           FontSize="14"
                                           Foreground="#9BABBE"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Detail content -->
                            <StackPanel x:Name="DetailContentPanel"
                                        Visibility="Collapsed"
                                        Margin="22,16">

                                <!-- Webcam Image -->
                                <Border Background="#F7FAFC"
                                        BorderBrush="#C8D6E5"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Margin="0,0,0,16"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Image -->
                                        <Image x:Name="SessionImage"
                                               Height="180"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode
                                               ="HighQuality"/>

                                        <!-- No image fallback -->
                                        <Border x:Name="NoImagePanel"
                                                Background="#F0F4F8"
                                                Height="180">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                                <TextBlock Text="📷"
                                                           FontSize="40"
                                                           HorizontalAlignment
                                                           ="Center"
                                                           Margin="0,0,0,10"/>
                                                <TextBlock
                                                    x:Name="NoImageText"
                                                    Text="No image captured"
                                                    FontSize="13"
                                                    Foreground="#9BABBE"
                                                    HorizontalAlignment
                                                    ="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Image overlay badge -->
                                        <Border x:Name="ImageBadge"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="#1B2E4B"
                                                CornerRadius="6,0,0,0"
                                                Padding="10,5"
                                                Visibility="Collapsed">
                                            <TextBlock Text="📸  Captured on login"
                                                       FontSize="11"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- User Info -->
                                <Border Background="#EBF5FB"
                                        BorderBrush="#AED6F1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="👤"
                                                   FontSize="22"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailFullName"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#1A5276"/>
                                            <TextBlock x:Name="DetailUsername"
                                                       FontSize="12"
                                                       Foreground="#2471A3"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Stats Grid -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Started At -->
                                    <Border Grid.Column="0" Grid.Row="0"
                                            Background="#F7FAFC"
                                            BorderBrush="#C8D6E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="🕐  STARTED"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#5A6A7E"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock x:Name="DetailStartTime"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#1B2E4B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Machine -->
                                    <Border Grid.Column="2" Grid.Row="0"
                                            Background="#F7FAFC"
                                            BorderBrush="#C8D6E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="🖥️  MACHINE"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#5A6A7E"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock x:Name="DetailMachine"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#1B2E4B"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Allocated -->
                                    <Border Grid.Column="0" Grid.Row="2"
                                            Background="#F7FAFC"
                                            BorderBrush="#C8D6E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="📋  ALLOCATED"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#5A6A7E"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock x:Name="DetailAllocated"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#1B2E4B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Elapsed -->
                                    <Border Grid.Column="2" Grid.Row="2"
                                            Background="#F7FAFC"
                                            BorderBrush="#C8D6E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="⏱  ELAPSED"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#5A6A7E"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock x:Name="DetailElapsed"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#1B2E4B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cost -->
                                    <Border Grid.Column="0"
                                            Grid.Row="4"
                                            Grid.ColumnSpan="3"
                                            Background="#FEF9F0"
                                            BorderBrush="#F9D29D"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="14,12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="💵  CURRENT BILLING"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#B7770D"
                                                    Margin="0,0,0,5"/>
                                                <TextBlock
                                                    x:Name="DetailCost"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="#B7770D"/>
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="RATE"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#B7770D"
                                                    HorizontalAlignment
                                                    ="Right"/>
                                                <TextBlock
                                                    Text="Rs. 2.00 / min"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#B7770D"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Actions Card ── -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect Color="#BBC8D8"
                                              BlurRadius="14"
                                              ShadowDepth="2"
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,16">
                                <TextBlock Text="⚡  "
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Session Actions"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1B2E4B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Selected User -->
                            <Border Background="#F7FAFC"
                                    BorderBrush="#C8D6E5"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="👤  SELECTED"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#5A6A7E"
                                               Margin="0,0,0,5"/>
                                    <TextBlock x:Name="SelectedUserText"
                                               Text="None selected"
                                               FontSize="14"
                                               Foreground="#1B2E4B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Warning -->
                            <TextBlock Text="⚠️  WARNING MESSAGE"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#4A5568"
                                       Margin="0,0,0,8"/>

                            <Border BorderBrush="#C8D6E5"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Background="#F7FAFC"
                                    Margin="0,0,0,10">
                                <TextBox x:Name="WarningMessageBox"
                                         Height="50"
                                         FontSize="13"
                                         Padding="14,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Text="Please follow the rules."
                                         TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="SendWarningButton"
                                    Height="46"
                                    Margin="0,0,0,10"
                                    FontSize="14" FontWeight="Bold"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Click="SendWarning_Click"
                                    Style="{StaticResource WarningButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📢  " FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Send Warning"
                                               FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="TerminateButton"
                                    Height="46"
                                    FontSize="14" FontWeight="Bold"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Click="TerminateSession_Click"
                                    Style=
                                    "{StaticResource AdminDangerButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛑  " FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Force Terminate"
                                               FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── Recent Alerts Card ── -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="22">
                        <Border.Effect>
                            <DropShadowEffect Color="#BBC8D8"
                                              BlurRadius="14"
                                              ShadowDepth="2"
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <TextBlock Text="🔔  " FontSize="15"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Recent Alerts"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#1B2E4B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListBox x:Name="AlertsListBox"
                                     MinHeight="160"
                                     MaxHeight="260"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12"
                                     Foreground="#3D566E"
                                     ScrollViewer.VerticalScrollBarVisibility
                                     ="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding"
                                                Value="10,8"/>
                                        <Setter Property="BorderThickness"
                                                Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush"
                                                Value="#EEF2F7"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ STATUS BAR ══════════════ -->
        <Border Grid.Row="3" Background="#1B2E4B" Padding="22,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📡  "
                               FontSize="12"
                               Foreground="#90B4D4"/>
                    <TextBlock x:Name="StatusBarText"
                               Text="Ready — Waiting for activity"
                               FontSize="12"
                               Foreground="#90B4D4"/>
                </StackPanel>
                <TextBlock x:Name="CurrentTimeText"
                           FontSize="12"
                           Foreground="#90B4D4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
