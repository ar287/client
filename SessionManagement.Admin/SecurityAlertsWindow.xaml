<Window x:Class="SessionManagement.Admin.SecurityAlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Alerts — Admin Hub"
        Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#C0392B">
            <StackPanel VerticalAlignment="Center" Margin="28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️  " FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Security Incident Hub" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Unauthorized access attempts and suspicious activities" FontSize="12" Foreground="#FADBD8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ALERTS" FontSize="11" FontWeight="Bold" Foreground="#7B241C"/>
                    <TextBlock x:Name="TotalAlertsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UNREAD ALERTS" FontSize="11" FontWeight="Bold" Foreground="#7B241C"/>
                    <TextBlock x:Name="UnreadAlertsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="LAST INCIDENT" FontSize="11" FontWeight="Bold" Foreground="#7B241C"/>
                    <TextBlock x:Name="LastIncidentText" Text="None" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABLE -->
        <Border Grid.Row="2" Margin="22,0,22,22" Background="White" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FDF2F1" CornerRadius="12,12,0,0" Padding="16,0">
                    <TextBlock Text="Alert Log" VerticalAlignment="Center" FontWeight="Bold" Foreground="#7B241C"/>
                </Border>

                <ListView x:Name="AlertsListView" Grid.Row="1" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding AlertId}"/>
                            <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding AlertType}"/>
                            <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="IP Address" Width="110" DisplayMemberBinding="{Binding IpAddress}"/>
                            <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding CreatedAt}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding IsRead}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="2" Background="#FDF2F1" CornerRadius="0,0,12,12" Padding="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                         <Button Content="Mark all as Read" Width="130" Height="36" Margin="0,0,10,0"
                                Style="{StaticResource AdminPrimaryButtonStyle}" Click="MarkAllRead_Click"/>
                        <Button Content="Close" Width="100" Height="36" Style="{StaticResource AdminPrimaryButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
