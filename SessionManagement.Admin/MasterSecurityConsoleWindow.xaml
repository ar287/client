<Window x:Class="SessionManagement.Admin.MasterSecurityConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Cyber Security Intelligence &amp; Control Console"
        Height="800" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F5">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- System Health Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Grid Launcher -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ 1. HEADER ══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#6366F1" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                    <TextBlock Text="👑" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI-Powered Cyber Lab Security Intelligence &amp; Operations Command Console"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Enterprise multi-module command center for session monitoring, threat detection, hybrid AI analytics, and remediation"
                               FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Content="🔄 Refresh System Health"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="40" Padding="18,0"
                    FontSize="12" FontWeight="Bold"
                    Foreground="White" Background="#334155"
                    BorderThickness="0" Cursor="Hand"
                    Click="Refresh_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ══════════════ 2. SYSTEM HEALTH BAR ══════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pill 1: Database -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#2563EB" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗄️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="SQL SERVER DATABASE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="DbStatusText" Text="Connected" FontSize="14" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pill 2: SignalR Hubs -->
            <Border Grid.Column="1" Margin="0,0,10,0" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#059669" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="SIGNALR REAL-TIME HUBS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="SignalRStatusText" Text="SessionHub &amp; AlertHub Active" FontSize="13" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pill 3: AI Engine -->
            <Border Grid.Column="2" Margin="0,0,10,0" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#7C3AED" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="OLLAMA AI INTELLIGENCE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="AiStatusText" Text="llama3.2:3b Ready" FontSize="14" FontWeight="Bold" Foreground="#7C3AED" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pill 4: Server Uptime -->
            <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#D97706" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="SERVER UPTIME" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="UptimeText" Text="0d 0h 0m 0s" FontSize="14" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════ 3. MODULE LAUNCHER GRID ══════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="3">

                <!-- Module 1: Analytics -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="📈 Operational Analytics" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="View revenue trends, utilization stats, peak session hours, and client usage summaries."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Analytics ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#3B82F6" BorderThickness="0" Cursor="Hand" Click="OpenAnalytics_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 2: Security Dashboard -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="🛡️ Security Intelligence" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Inspect active security policies, evaluate risk metrics, and monitor threat levels across all PCs."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Security Dashboard ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#EF4444" BorderThickness="0" Cursor="Hand" Click="OpenSecurity_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 3: AI Insights -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="🧠 AI Risk &amp; Insights" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Generate LLM threat summaries, anomaly narratives, and natural language rule suggestions."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch AI Insights ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#10B981" BorderThickness="0" Cursor="Hand" Click="OpenAiInsights_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 4: Visual Rule Builder -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="🎨 Visual Rule Builder" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Design security policies visually or convert plain English intent into executable rules using AI."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Rule Builder ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#8B5CF6" BorderThickness="0" Cursor="Hand" Click="OpenRuleBuilder_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 5: Live SignalR Alert Feed -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="🔴 Real-Time Live Alert Feed" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Stream high-priority threat warnings and policy triggers live via SignalR AlertHub."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Live Alert Feed ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#DC2626" BorderThickness="0" Cursor="Hand" Click="OpenLiveAlerts_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 6: Authorization Queue -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="⚖️ Authorization &amp; Approval Queue" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Review pending high-risk rule actions and authorize or reject automated enforcement."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Approval Queue ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#0284C7" BorderThickness="0" Cursor="Hand" Click="OpenApprovals_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 7: Remediation Control -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="⚡ Threat Remediation Engine" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Dispatch screen locks, process terminations, or session cut-offs to client workstations."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Remediation Control ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#D97706" BorderThickness="0" Cursor="Hand" Click="OpenRemediation_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 8: Forensic Audit Export -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="📁 Forensic Audit Trail Exporter" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Generate comprehensive compliance audit trails and export forensic logs in CSV and JSON formats."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Forensic Exporter ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#059669" BorderThickness="0" Cursor="Hand" Click="OpenAuditExport_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Module 9: Core Session Dashboard -->
                <Border Margin="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="🖥️ Workstation Fleet Dashboard" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Monitor active client PC heartbeats, active customer sessions, timer countdowns, and billing."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Button Content="Launch Fleet Monitor ➔" Height="36" FontSize="12" FontWeight="Bold" Foreground="White" Background="#4F46E5" BorderThickness="0" Cursor="Hand" Click="OpenFleetMonitor_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </ScrollViewer>

        <!-- ══════════════ 4. FOOTER ══════════════ -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Master Control Console initialized." FontSize="12" Foreground="#64748B" Margin="0,12,0,0"/>
    </Grid>
</Window>
