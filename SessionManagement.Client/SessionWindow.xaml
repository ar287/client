<Window x:Class="SessionManagement.Client.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Management — Active Session"
        Height="780" Width="580"
        MinHeight="700" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B2E4B">
            <Grid Margin="32,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️  "
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                        <TextBlock x:Name="WelcomeText"
                                   Text="Welcome!"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Manage your session below"
                               FontSize="13"
                               Foreground="#90B4D4"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Customer Badge -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#2E4D7B"
                        CornerRadius="20"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤  "
                                   FontSize="12"
                                   Foreground="#90B4D4"/>
                        <TextBlock Text="CUSTOMER"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#90B4D4"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════ SCROLL CONTENT ══════════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#2E4D7B" Margin="0,0,4,0" CornerRadius="8,8,0,0">
                                    <ContentPresenter ContentSource="Header" Margin="24,12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#ECF0F5"/>
                                        <Setter Property="Foreground" Value="#1B2E4B"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#90B4D4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
 
            <TabItem Header="🚀  Active Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- ════ TIME SELECTION PANEL ════ -->
                <Border x:Name="TimeSelectionPanel"
                        Background="White"
                        CornerRadius="14"
                        Padding="32,28">
                    <Border.Effect>
                        <DropShadowEffect Color="#BBC8D8"
                                          BlurRadius="20"
                                          ShadowDepth="3"
                                          Opacity="0.22"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Panel Title -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,6">
                            <TextBlock Text="⏱️  "
                                       FontSize="20"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Select Session Duration"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1B2E4B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Choose how long you want to use the system."
                                   FontSize="13"
                                   Foreground="#7A8CA0"
                                   Margin="0,0,0,26"/>

                        <!-- Quick Select Label -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="⚡  "
                                       FontSize="12"
                                       Foreground="#4A5568"/>
                            <TextBlock Text="QUICK SELECT"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>

                        <!-- Quick Buttons Grid -->
                        <UniformGrid Columns="3"
                                     Margin="0,0,0,26">
                            <Button Content="30 min"
                                    Margin="0,0,8,8"
                                    Height="50" Tag="30"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                            <Button Content="1 hour"
                                    Margin="0,0,8,8"
                                    Height="50" Tag="60"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                            <Button Content="2 hours"
                                    Margin="0,0,0,8"
                                    Height="50" Tag="120"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                            <Button Content="3 hours"
                                    Margin="0,0,8,0"
                                    Height="50" Tag="180"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                            <Button Content="4 hours"
                                    Margin="0,0,8,0"
                                    Height="50" Tag="240"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                            <Button Content="5 hours"
                                    Margin="0,0,0,0"
                                    Height="50" Tag="300"
                                    Click="QuickSelect_Click"
                                    Style="{StaticResource QuickButtonStyle}"/>
                        </UniformGrid>

                        <!-- Custom Minutes -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="✏️  "
                                       FontSize="12"
                                       Foreground="#4A5568"/>
                            <TextBlock Text="OR ENTER CUSTOM MINUTES"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>

                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC"
                                Margin="0,0,0,22">
                            <TextBox x:Name="CustomMinutesBox"
                                     Height="50"
                                     FontSize="16"
                                     Padding="16,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="#1B2E4B"
                                     Text="60"/>
                        </Border>

                        <!-- Pricing Info Card -->
                        <Border Background="#EBF5FB"
                                BorderBrush="#AED6F1"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="20,16"
                                Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="💰"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="RATE/MIN"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#2471A3"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rs. 2.00"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1A5276"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="🕐"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="1 HOUR"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#2471A3"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rs. 120"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1A5276"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="🕑"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="2 HOURS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#2471A3"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rs. 240"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1A5276"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Error Box -->
                        <Border x:Name="SessionErrorBorder"
                                Background="#FEF0EF"
                                BorderBrush="#F5B7B1"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="18,14"
                                Margin="0,0,0,18"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  "
                                           FontSize="16"
                                           Foreground="#C0392B"/>
                                <TextBlock x:Name="SessionErrorMessage"
                                           FontSize="14"
                                           Foreground="#C0392B"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Start Button -->
                        <Button x:Name="StartButton"
                                Height="54"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                BorderThickness="0"
                                Click="StartButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶  "
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Start Session"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ════ ACTIVE SESSION PANEL ════ -->
                <Border x:Name="ActiveSessionPanel"
                        Background="White"
                        CornerRadius="14"
                        Padding="32,28"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#BBC8D8"
                                          BlurRadius="20"
                                          ShadowDepth="3"
                                          Opacity="0.22"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Timer Label -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
                            <TextBlock Text="⏳  "
                                       FontSize="14"
                                       Foreground="#4A5568"/>
                            <TextBlock Text="TIME REMAINING"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </StackPanel>

                        <!-- Big Countdown Timer -->
                        <Border Background="#EBF5FB"
                                CornerRadius="14"
                                Padding="24,20"
                                Margin="0,0,0,14">
                            <TextBlock x:Name="TimerDisplay"
                                       Text="00:00:00"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="#1A5276"
                                       HorizontalAlignment="Center"
                                       FontFamily="Courier New"/>
                        </Border>

                        <!-- Status -->
                        <TextBlock x:Name="SessionStatusText"
                                   Text="✅  Session is active"
                                   FontSize="14"
                                   Foreground="#1E8449"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,26"/>

                        <!-- Stats Cards -->
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Started At -->
                            <Border Grid.Column="0" Grid.Row="0"
                                    Background="#F7FAFC"
                                    BorderBrush="#C8D6E5"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="🕐  "
                                                   FontSize="13"
                                                   Foreground="#5A6A7E"/>
                                        <TextBlock Text="STARTED AT"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StartTimeText"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1B2E4B"/>
                                </StackPanel>
                            </Border>

                            <!-- Allocated -->
                            <Border Grid.Column="2" Grid.Row="0"
                                    Background="#F7FAFC"
                                    BorderBrush="#C8D6E5"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="📋  "
                                                   FontSize="13"
                                                   Foreground="#5A6A7E"/>
                                        <TextBlock Text="ALLOCATED"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AllocatedText"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1B2E4B"/>
                                </StackPanel>
                            </Border>

                            <!-- Elapsed -->
                            <Border Grid.Column="0" Grid.Row="2"
                                    Background="#F7FAFC"
                                    BorderBrush="#C8D6E5"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="⏱  "
                                                   FontSize="13"
                                                   Foreground="#5A6A7E"/>
                                        <TextBlock Text="ELAPSED"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#5A6A7E"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ElapsedText"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1B2E4B"/>
                                </StackPanel>
                            </Border>

                            <!-- Cost -->
                            <Border Grid.Column="2" Grid.Row="2"
                                    Background="#FEF9F0"
                                    BorderBrush="#F9D29D"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="💵  "
                                                   FontSize="13"
                                                   Foreground="#B7770D"/>
                                        <TextBlock Text="ESTIMATED COST"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#B7770D"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CostText"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#B7770D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- View Billing Button -->
                        <Button Height="50"
                                Margin="0,0,0,12"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#1B2E4B"
                                BorderThickness="0"
                                Click="ViewBilling_Click"
                                Style="{StaticResource GhostButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊  "
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="View Billing History"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- End Session Button -->
                        <Button x:Name="EndButton"
                                Height="54"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                BorderThickness="0"
                                Click="EndButton_Click"
                                Style="{StaticResource DangerButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏹  "
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="End Session"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
                </ScrollViewer>
            </TabItem>
 
            <TabItem Header="📊  My Bills" x:Name="MyBillsTab" Selector.Selected="MyBillsTab_Selected">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Billing History" FontSize="20" FontWeight="Bold" Foreground="#1B2E4B"/>
                            <TextBlock Text="Review your past session records and payment status." FontSize="14" Foreground="#7A8CA0" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
 
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="0">
                        <ListView x:Name="BillingHistoryListView" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="180" DisplayMemberBinding="{Binding GeneratedAt}"/>
                                    <GridViewColumn Header="Session" Width="80" DisplayMemberBinding="{Binding SessionId}"/>
                                    <GridViewColumn Header="Duration" Width="100" DisplayMemberBinding="{Binding TotalMinutesDisplay}"/>
                                    <GridViewColumn Header="Amount" Width="120" DisplayMemberBinding="{Binding TotalAmountDisplay}"/>
                                    <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding PaidDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
