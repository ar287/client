<Window x:Class="SessionManagement.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Management System — Login"
        Height="680" Width="520"
        MinHeight="620" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#ECF0F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="620">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════ HEADER ══════════════ -->
            <Border Grid.Row="0" Background="#1B2E4B">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="40">

                    <!-- Icon Badge -->
                    <Border Width="76" Height="76"
                            Background="#2E4D7B"
                            CornerRadius="38"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="🔐"
                                   FontSize="34"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Session Management System"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Sign in to start your session"
                               FontSize="14"
                               Foreground="#90B4D4"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══════════════ FORM CARD ══════════════ -->
            <Border Grid.Row="1"
                    Margin="44,28,44,44"
                    Background="White"
                    CornerRadius="14"
                    Padding="40,36">
                <Border.Effect>
                    <DropShadowEffect Color="#BBC8D8"
                                      BlurRadius="24"
                                      ShadowDepth="4"
                                      Opacity="0.28"/>
                </Border.Effect>

                <StackPanel>

                    <!-- ── Username Field ── -->
                    <StackPanel Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="👤"
                                       FontSize="15"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="USERNAME"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC">
                            <TextBox x:Name="UsernameTextBox"
                                     Height="50"
                                     FontSize="15"
                                     Padding="16,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="#1B2E4B"/>
                        </Border>
                    </StackPanel>

                    <!-- ── Password Field ── -->
                    <StackPanel Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="🔑"
                                       FontSize="15"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="PASSWORD"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="#C8D6E5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Background="#F7FAFC">
                            <PasswordBox x:Name="PasswordBox"
                                         Height="50"
                                         FontSize="15"
                                         Padding="16,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Foreground="#1B2E4B"/>
                        </Border>
                    </StackPanel>

                    <!-- ── Error Box ── -->
                    <Border x:Name="ErrorBorder"
                            Background="#FEF0EF"
                            BorderBrush="#F5B7B1"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="18,14"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠"
                                       FontSize="18"
                                       Foreground="#C0392B"
                                       VerticalAlignment="Top"
                                       Margin="0,2,12,0"/>
                            <TextBlock x:Name="ErrorMessage"
                                       FontSize="14"
                                       Foreground="#C0392B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Success Box ── -->
                    <Border x:Name="SuccessBorder"
                            Background="#EAFAF1"
                            BorderBrush="#A9DFBF"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="18,14"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅"
                                       FontSize="18"
                                       Foreground="#1E8449"
                                       VerticalAlignment="Top"
                                       Margin="0,2,12,0"/>
                            <TextBlock x:Name="SuccessMessage"
                                       FontSize="14"
                                       Foreground="#1E8449"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Login Button ── -->
                    <Button x:Name="LoginButton"
                            Height="54"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,0,20"
                            Click="LoginButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔓  "
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Sign In"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ── Divider ── -->
                    <Border BorderBrush="#E8EDF2"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,16"/>

                    <!-- ── Footer ── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ℹ️  "
                                   FontSize="13"
                                   Foreground="#9BABBE"/>
                        <TextBlock Text="Contact administrator if you cannot sign in."
                                   FontSize="13"
                                   Foreground="#9BABBE"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
